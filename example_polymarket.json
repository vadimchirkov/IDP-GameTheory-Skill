{
  "schemaVersion": 1,
  "adapter": "polymarket",
  "situation": "Polymarket binary market — Will candidate X win? Market price vs true prob, evaluate YES/NO/ABSTAIN/LP across same worlds",
  "model": {
    "markets": [
      {
        "id": "main",
        "question": "Will X win the election?",
        "marketPrice": [0.52, 0.62],
        "trueProb": [0.45, 0.65]
      }
    ],
    "positions": [
      { "id": "long_yes", "label": "Long YES", "side": "YES", "size": [100, 100] },
      { "id": "long_no", "label": "Long NO", "side": "NO", "size": [100, 100] },
      { "id": "abstain", "label": "Abstain", "side": "ABSTAIN", "size": [0, 0] },
      { "id": "lp", "label": "LP (provide liquidity)", "side": "LP", "size": [200, 200] }
    ],
    "fee": [0.015, 0.025],
    "slippage": [0.0, 0.01],
    "lpRebate": [0.005, 0.015]
  },
  "topology": {
    "nodes": ["market"],
    "interactions": []
  }
}
